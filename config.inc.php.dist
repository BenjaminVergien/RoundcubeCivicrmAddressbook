<?php
$config['civicrm_api4_url'] = getenv('CIVICRM_API4_URL') ?: '';
$config['civicrm_api4_key'] = getenv('CIVICRM_API4_KEY') ?: '';
$config['civicrm_site_key'] = getenv('CIVICRM_SITE_KEY') ?: '';
$config['civicrm_log_searches'] = true;
$config['civicrm_filing_dir'] = getenv('CIVICRM_FILING_DIR') ?: null;
// Filing defaults on only when a journal directory is explicitly configured.
$filing = getenv('CIVICRM_FILING_ENABLED');
$config['civicrm_filing_enabled'] = $filing === false
    ? $config['civicrm_filing_dir'] !== null : filter_var($filing, FILTER_VALIDATE_BOOLEAN);
$config['civicrm_filing_max_mib'] = getenv('CIVICRM_FILING_MAX_MIB') ?: 25;
